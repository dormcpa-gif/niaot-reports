# Copy to .env (or export these in your shell) before running the backend locally.
# .env itself is gitignored -- never commit real keys.

# First admin account, created automatically on startup if the users
# table is still empty (see app/api/auth.py bootstrap_admin_if_needed).
# Only used once -- after that, admins create every other account
# through the /admin/users routes (or the "ניהול" section in the UI).
ADMIN_EMAIL=dor@cpa-adv.com
ADMIN_PASSWORD=

# Comma-separated extra origins allowed to call the API (beyond localhost
# and the production Netlify URL already hardcoded in app/main.py).
ALLOWED_ORIGINS=

# Required for the "ניתוח מעמיק (AI)" deep-analysis feature
# (app/services/llm_analysis_service.py). Get a key at console.anthropic.com.
# Every analysis run makes a real, billed API call -- there is no free tier.
# Without this set, every other feature in the app still works normally;
# only POST /analysis/deep returns a clear 422 error.
ANTHROPIC_API_KEY=

# Optional: override the default model (claude-sonnet-5).
ANTHROPIC_MODEL=
